# ──────────────────────────────────────────────────────────────────────────
# BisnisKu environment variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project settings for production.

# Database (Turso). Create a free database at https://turso.tech.
# In development you can leave these unset — the app then uses a local SQLite
# file at ./data/database.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real value. Without this the app cannot sign sessions.
LICENSE_SECRET=

# Ed25519 public key that verifies license files. Produced by the generator
# the first time you run `npm run license:gen` (also written to
# data/license-public.key). Paste it here and in the Vercel env vars.
LICENSE_PUBLIC_KEY=
